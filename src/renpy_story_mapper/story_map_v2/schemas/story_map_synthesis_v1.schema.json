{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-map-v2-synthesis-response-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["story_title", "story_overview", "ordered_sections", "optional_threads"],
  "properties": {
    "story_title": {"type": "string", "minLength": 1, "maxLength": 160},
    "story_overview": {"type": "string", "minLength": 1, "maxLength": 2000},
    "ordered_sections": {
      "type": "array",
      "minItems": 5,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/section"}
    },
    "optional_threads": {
      "type": "array",
      "maxItems": 2,
      "items": {"$ref": "#/$defs/thread"}
    }
  },
  "$defs": {
    "anchors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_title", "section_summary", "event_anchor_ids"],
      "properties": {
        "section_title": {"type": "string", "minLength": 1, "maxLength": 160},
        "section_summary": {"type": "string", "minLength": 1, "maxLength": 1500},
        "event_anchor_ids": {"$ref": "#/$defs/anchors"}
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "event_anchor_ids"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
        "event_anchor_ids": {"$ref": "#/$defs/anchors"}
      }
    }
  }
}
