{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard-story-analysis-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "scenes", "choices", "transitions", "claims", "excluded_evidence_ids", "unresolved", "disagreements"],
  "properties": {
    "schema": {"const": "storyboard-story-analysis-v1"},
    "title": {"$ref": "#/$defs/text"},
    "story_title": {"$ref": "#/$defs/text"},
    "summary": {"type": "string"},
    "status": {"$ref": "#/$defs/status"},
    "uncertainty": {"type": ["string", "null"]},
    "source": {"$ref": "#/$defs/source"},
    "scenes": {"type": "array", "items": {"$ref": "#/$defs/scene"}},
    "choices": {"type": "array", "items": {"$ref": "#/$defs/choice"}},
    "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}},
    "continuations": {"type": "array", "items": {"$ref": "#/$defs/continuation"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "excluded_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}},
    "unresolved": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}},
    "disagreements": {"type": "array", "items": {"$ref": "#/$defs/disagreement"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "line_evidence_ids": {"type": "array", "minItems": 0, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "status": {"type": "string", "enum": ["resolved", "uncertain", "unresolved", "excluded"]},
    "uncertainty": {"type": ["string", "null"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_index_hash", "profile_hash", "canary_evidence_ids"],
      "properties": {
        "evidence_index_hash": {"$ref": "#/$defs/text"},
        "profile_hash": {"$ref": "#/$defs/text"},
        "canary_evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "claim_fields": {
      "type": "object",
      "properties": {
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "status": {"$ref": "#/$defs/status"},
        "uncertainty": {"$ref": "#/$defs/uncertainty"},
        "unresolved": {"type": "string"},
        "rationale": {"type": ["string", "null"]},
        "interpretation_rationale": {"type": ["string", "null"]}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "order", "evidence_ids", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "title": {"$ref": "#/$defs/text"},
        "summary": {"$ref": "#/$defs/text"},
        "order": {"type": "integer", "minimum": 0},
        "line_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "leaf_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "body_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "member_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "choice_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "status": {"$ref": "#/$defs/status"},
        "uncertainty": {"$ref": "#/$defs/uncertainty"},
        "unresolved": {"type": "string"},
        "rationale": {"type": ["string", "null"]},
        "interpretation_rationale": {"type": ["string", "null"]},
        "choices": {"type": "array", "items": {"type": "object"}},
        "branches": {"type": "array", "items": {"type": "object"}}
      }
    },
    "consequence": {
      "oneOf": [
        {"type": "string"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "evidence_ids", "confidence"],
          "properties": {
            "text": {"$ref": "#/$defs/text"},
            "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
            "confidence": {"$ref": "#/$defs/confidence"},
            "status": {"$ref": "#/$defs/status"},
            "uncertainty": {"$ref": "#/$defs/uncertainty"},
            "unresolved": {"type": "string"},
            "rationale": {"type": ["string", "null"]}
          }
        }
      ]
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "caption", "consequence", "evidence_ids", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "caption": {"$ref": "#/$defs/text"},
        "condition": {"type": ["string", "null"]},
        "condition_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "line_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "leaf_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "body_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "member_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "source_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "target_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "consequence": {"$ref": "#/$defs/consequence"},
        "destination_id": {"type": ["string", "null"]},
        "destination_scene_id": {"type": ["string", "null"]},
        "destination_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "rejoin_id": {"type": ["string", "null"]},
        "rejoin_scene_id": {"type": ["string", "null"]},
        "rejoin_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "destination": {"type": "object"},
        "rejoin": {"type": ["string", "object", "null"]},
        "terminal": {"type": "string", "enum": ["none", "ending", "loop", "unresolved"]},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "status": {"$ref": "#/$defs/status"},
        "uncertainty": {"$ref": "#/$defs/uncertainty"},
        "unresolved": {"type": "string"},
        "rationale": {"type": ["string", "null"]},
        "interpretation_rationale": {"type": ["string", "null"]}
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scene_id", "caption", "condition", "arms", "evidence_ids", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "scene_id": {"$ref": "#/$defs/text"},
        "caption": {"$ref": "#/$defs/text"},
        "condition": {"type": ["string", "null"]},
        "condition_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "menu_evidence_id": {"$ref": "#/$defs/text"},
        "arms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/arm"}},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "source_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "status": {"$ref": "#/$defs/status"},
        "uncertainty": {"$ref": "#/$defs/uncertainty"},
        "unresolved": {"type": "string"},
        "rationale": {"type": ["string", "null"]},
        "interpretation_rationale": {"type": ["string", "null"]}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from_id", "to_id", "kind", "evidence_ids", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "from_id": {"$ref": "#/$defs/text"},
        "to_id": {"type": ["string", "null"]},
        "source_scene_id": {"type": ["string", "null"]},
        "destination_scene_id": {"type": ["string", "null"]},
        "source_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "target_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "kind": {"type": "string"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "status": {"$ref": "#/$defs/status"},
        "uncertainty": {"$ref": "#/$defs/uncertainty"},
        "unresolved": {"type": "string"},
        "rationale": {"type": ["string", "null"]}
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidence_ids", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "scene_id": {"type": ["string", "null"]},
        "title": {"type": "string"},
        "line_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "leaf_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "body_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "member_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "status": {"$ref": "#/$defs/status"},
        "uncertainty": {"$ref": "#/$defs/uncertainty"},
        "unresolved": {"type": "string"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "evidence_ids", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "text": {"$ref": "#/$defs/text"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "status": {"$ref": "#/$defs/status"},
        "uncertainty": {"$ref": "#/$defs/uncertainty"},
        "unresolved": {"type": "string"},
        "rationale": {"type": ["string", "null"]},
        "interpretation_rationale": {"type": ["string", "null"]}
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topic", "description", "evidence_ids", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "topic": {"$ref": "#/$defs/text"},
        "description": {"$ref": "#/$defs/text"},
        "line_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "status": {"$ref": "#/$defs/status"},
        "uncertainty": {"$ref": "#/$defs/uncertainty"},
        "unresolved": {"type": "string"},
        "owns_evidence": {"type": "boolean"}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "reason", "confidence"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/text"},
        "line_evidence_ids": {"$ref": "#/$defs/line_evidence_ids"},
        "reason": {"$ref": "#/$defs/text"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "status": {"$ref": "#/$defs/status"},
        "uncertainty": {"$ref": "#/$defs/text"},
        "unresolved": {"type": "string"}
      }
    },
    "disagreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topic", "ai_statement", "deterministic_evidence_ids", "confidence", "resolution"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "topic": {"$ref": "#/$defs/text"},
        "ai_statement": {"$ref": "#/$defs/text"},
        "deterministic_evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "parser": {"type": "string"},
        "ai": {"type": "string"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "resolution": {"type": "string", "enum": ["unresolved", "deterministic", "ai", "needs_review"]},
        "status": {"$ref": "#/$defs/status"},
        "uncertainty": {"$ref": "#/$defs/uncertainty"},
        "unresolved": {"type": "string"}
      }
    }
  }
}
