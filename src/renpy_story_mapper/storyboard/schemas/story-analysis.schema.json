{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard-story-analysis-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "scenes",
    "choices",
    "transitions",
    "claims",
    "excluded_evidence_ids",
    "unresolved",
    "disagreements"
  ],
  "properties": {
    "schema": {"const": "storyboard-story-analysis-v1"},
    "source": {"$ref": "#/$defs/source"},
    "scenes": {
      "type": "array",
      "items": {"$ref": "#/$defs/scene"}
    },
    "choices": {
      "type": "array",
      "items": {"$ref": "#/$defs/choice"}
    },
    "transitions": {
      "type": "array",
      "items": {"$ref": "#/$defs/transition"}
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "excluded_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "unresolved": {
      "type": "array",
      "items": {"$ref": "#/$defs/unresolved"}
    },
    "disagreements": {
      "type": "array",
      "items": {"$ref": "#/$defs/disagreement"}
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_ids", "confidence", "unresolved"],
      "properties": {
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "unresolved": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_index_hash", "profile_hash", "canary_evidence_ids"],
      "properties": {
        "evidence_index_hash": {"$ref": "#/$defs/text"},
        "profile_hash": {"$ref": "#/$defs/text"},
        "canary_evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "order",
        "line_evidence_ids",
        "choice_ids",
        "evidence_ids",
        "confidence",
        "unresolved"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "title": {"$ref": "#/$defs/text"},
        "summary": {"$ref": "#/$defs/text"},
        "order": {"type": "integer", "minimum": 0},
        "line_evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "choice_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "unresolved": {"type": "string"}
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "caption",
        "line_evidence_ids",
        "consequence",
        "destination_id",
        "rejoin_id",
        "terminal",
        "evidence_ids",
        "confidence",
        "unresolved"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "caption": {"$ref": "#/$defs/text"},
        "line_evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "consequence": {"$ref": "#/$defs/text"},
        "destination_id": {"type": ["string", "null"]},
        "rejoin_id": {"type": ["string", "null"]},
        "terminal": {
          "type": "string",
          "enum": ["none", "ending", "loop", "unresolved"]
        },
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "unresolved": {"type": "string"}
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scene_id",
        "caption",
        "condition",
        "arms",
        "evidence_ids",
        "confidence",
        "unresolved"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "scene_id": {"$ref": "#/$defs/text"},
        "caption": {"$ref": "#/$defs/text"},
        "condition": {"type": ["string", "null"]},
        "arms": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/arm"}
        },
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "unresolved": {"type": "string"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from_id",
        "to_id",
        "kind",
        "evidence_ids",
        "confidence",
        "unresolved"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "from_id": {"$ref": "#/$defs/text"},
        "to_id": {"type": ["string", "null"]},
        "kind": {
          "type": "string",
          "enum": [
            "fallthrough",
            "jump",
            "call",
            "return",
            "condition",
            "choice",
            "destination",
            "rejoin",
            "loop",
            "ending",
            "unresolved"
          ]
        },
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "unresolved": {"type": "string"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "evidence_ids", "confidence", "unresolved"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "text": {"$ref": "#/$defs/text"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "unresolved": {"type": "string"}
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topic", "description", "evidence_ids", "confidence", "unresolved"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "topic": {"$ref": "#/$defs/text"},
        "description": {"$ref": "#/$defs/text"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "unresolved": {"type": "string"}
      }
    },
    "disagreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topic",
        "ai_statement",
        "deterministic_evidence_ids",
        "confidence",
        "resolution",
        "unresolved"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "topic": {"$ref": "#/$defs/text"},
        "ai_statement": {"$ref": "#/$defs/text"},
        "deterministic_evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "resolution": {
          "type": "string",
          "enum": ["unresolved", "deterministic", "ai", "needs_review"]
        },
        "unresolved": {"type": "string"}
      }
    }
  }
}
